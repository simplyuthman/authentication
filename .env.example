# Copy this file to .env and fill in real values.
# .env is in .gitignore and must never be committed.

# PostgreSQL connection string — matches docker-compose.yml for local development.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db"

# A random secret used for session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Nodemailer / SMTP Configuration
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false" # set to "true" for port 465, "false" for 587 or 25
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-smtp-password-or-app-password"
# EMAIL_FROM="\"Auth Service\" <noreply@example.com>"

